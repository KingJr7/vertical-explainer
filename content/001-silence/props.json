    },
    {
      "id": "s12",
      "startFrame": 853,
      "durationInFrames": 74,
      "text": "Un craquement. Et tout bascule.",
      "broll": {
        "kind": "video",
        "src": "content/001-silence/broll/s12.mp4",
        "kenBurns": "in"
      },
      "enter": {
        "kind": "push",
