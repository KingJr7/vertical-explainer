  "scenes": [
    {
      "id": "s1",
      "startFrame": 0,
      "durationInFrames": 102,
      "text": "Le moment le plus angoissant d'un film, c'est souvent le silence.",
      "broll": {
        "kind": "none",
        "src": null,
        "kenBurns": "in"
      },
      "enter": {
        "kind": "push",
        "dir": "up"
      },
      "exit": {
        "kind": "push",
        "dir": "up"
      },
      "accent": "silence",
      "invert": false
    },
    {
      "id": "s2",
      "startFrame": 88,
      "durationInFrames": 91,
      "text": "Pas la musique. Pas le cri. Le vide.",
      "broll": {
        "kind": "none",
        "src": null,
        "kenBurns": "in"
      },
      "enter": {
        "kind": "push",
        "dir": "up"
      },
      "exit": {
        "kind": "handoff",
        "dir": "left"
      },
      "accent": "vide",
      "invert": false
    },
    {
      "id": "s3",
      "startFrame": 165,
      "durationInFrames": 103,
      "text": "Un bruit constant devient un fond, et ton cerveau l'ignore.",
      "broll": {
        "kind": "video",
        "src": "content/001-silence/broll/s3.mp4",
        "kenBurns": "left"
      },
      "enter": {
        "kind": "handoff",
        "dir": "left"
      },
      "exit": {
        "kind": "push",
        "dir": "up"
      },
      "accent": null,
      "invert": false
    },
    {
      "id": "s4",
      "startFrame": 254,
      "durationInFrames": 84,
      "text": "Coupe ce fond, et il cherche ce qui manque.",
      "broll": {
        "kind": "video",
        "src": "content/001-silence/broll/s4.mp4",
        "kenBurns": "in"
      },
      "enter": {
        "kind": "push",
        "dir": "up"
      },
      "exit": {
        "kind": "push",
        "dir": "up"
      },
      "accent": null,
      "invert": false
    },
    {
      "id": "s5",
      "startFrame": 324,
      "durationInFrames": 71,
      "text": "C'est là qu'il commence à imaginer.",
      "broll": {
        "kind": "none",
        "src": null,
        "kenBurns": "in"
      },
      "enter": {
        "kind": "push",
        "dir": "up"
      },
      "exit": {
        "kind": "whip",
        "dir": "left"
      },
      "accent": null,
      "invert": false
    },
    {
      "id": "s6",
      "startFrame": 381,
      "durationInFrames": 113,
      "text": "Une porte. Un pas. Quelque chose derrière toi.",
      "broll": {
        "kind": "none",
        "src": null,
        "kenBurns": "in"
      },
      "enter": {
        "kind": "whip",
        "dir": "left"
      },
      "exit": {
        "kind": "push",
        "dir": "up"
      },
      "accent": null,
      "invert": false
    },
    {
      "id": "s7",
      "startFrame": 480,
      "durationInFrames": 108,
      "text": "Le silence ne montre rien. Ton cerveau fait le travail.",
      "broll": {
        "kind": "video",
        "src": "content/001-silence/broll/s7.mp4",
        "kenBurns": "left"
      },
      "enter": {
        "kind": "push",
        "dir": "up"
      },
      "exit": {
        "kind": "handoff",
        "dir": "up"
      },
      "accent": null,
      "invert": false
    },
    {
      "id": "s8",
      "startFrame": 574,
      "durationInFrames": 80,
      "text": "Mais il ne marche que s'il est préparé.",
      "broll": {
        "kind": "video",
        "src": "content/001-silence/broll/s8.mp4",
        "kenBurns": "in"
      },
      "enter": {
        "kind": "handoff",
        "dir": "up"
      },
      "exit": {
        "kind": "push",
        "dir": "up"
      },
      "accent": null,
      "invert": false
    },
    {
      "id": "s9",
      "startFrame": 640,
      "durationInFrames": 82,
      "text": "Trop de vide, et l'oreille décroche.",
      "broll": {
        "kind": "video",
        "src": "content/001-silence/broll/s9.mp4",
        "kenBurns": "in"
      },
      "enter": {
        "kind": "push",
        "dir": "up"
      },
      "exit": {
        "kind": "push",
        "dir": "up"
      },
      "accent": null,
      "invert": false
    },
    {
      "id": "s10",
      "startFrame": 708,
      "durationInFrames": 104,
      "text": "Il faut du bruit avant, pour que le silence existe.",
      "broll": {
        "kind": "video",
        "src": "content/001-silence/broll/s10.mp4",
        "kenBurns": "out"
      },
      "enter": {
        "kind": "push",
