      "accent": null,
      "enter": { "kind": "push", "dir": "up" },
      "sfx": [{ "name": "tick", "at": "mid", "gainDb": -18 }],
      "invert": false
    },
    {
      "text": "Mais il ne marche que s'il est préparé.",
